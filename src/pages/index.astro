---
import ProjectCard from '../components/ProjectCard.astro';
import SiteLayout from '../components/SiteLayout.astro';
import { engineeringEvidence, projects } from '../data/projects';

const featuredProjects = projects.filter((project) => project.featured);
const otherProjects = projects.filter((project) => !project.featured);
const description =
  'Chrish Oula is a Software Engineer in Kampala, Uganda, building mobile and web products, business software, and open-source developer tools.';
---

<SiteLayout
  title="Chrish Oula — Software Engineer"
  description={description}
>
  <main id="main">
    <section class="hero page-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow hero-location">Software Engineer <span aria-hidden="true">·</span> Kampala, Uganda</p>
        <h1 id="hero-title">Chrish Oula<span class="hero-role">Software Engineer</span></h1>
        <p class="hero-intro">
          I build reliable full-stack applications, mobile experiences, and open-source developer
          tools.
        </p>
        <p class="hero-manifesto">I engineer software that solves <em>real-world</em> problems.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">↘</span></a>
          <a class="button button-secondary" href="/Oula-Chrish-CV.pdf" download>
            Download CV <span aria-hidden="true">↓</span>
          </a>
          <a
            class="button button-secondary"
            href="https://github.com/Gabions256"
            target="_blank"
            rel="noreferrer"
          >View GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-meta">
          <span class="availability-inline"><span class="availability-dot" aria-hidden="true"></span>Open to international and remote opportunities</span>
          <a href="https://www.linkedin.com/in/oula-chrish-6a538323b" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <figure class="hero-portrait">
        <img
          src="/chrish-oula-portrait.webp"
          alt="Chrish Oula, Software Engineer"
          width="1000"
          height="1094"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>
          <span>CHRISH OULA</span>
          <span>SOFTWARE ENGINEER · KAMPALA, UGANDA</span>
        </figcaption>
      </figure>
    </section>

    <section class="proof-strip" aria-label="Professional focus">
      <div class="page-shell proof-grid">
        <p>Building at <strong>GAB Software Company Limited</strong></p>
        <span class="proof-divider" aria-hidden="true"></span>
        <p>Focus <strong>Full-stack · Mobile · Developer tools</strong></p>
        <span class="proof-divider" aria-hidden="true"></span>
        <p>Working from <strong>Kampala, Uganda</strong></p>
      </div>
    </section>

    <section class="work-section page-shell section-space" id="work" aria-labelledby="work-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Selected engineering work <span>01 / 04</span></p>
          <h2 id="work-title">Useful software.<br /><em>Thoughtfully engineered.</em></h2>
        </div>
        <p class="section-note">
          My work spans local-first developer tools, agricultural software, and practical finance products.
        </p>
      </div>
      <div class="project-grid">
        {featuredProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
      <div class="additional-projects">
        <div>
          <p class="eyebrow">More work</p>
          <p class="additional-note">A released Android product, an internal test build, and a private prototype.</p>
        </div>
        <div class="additional-list">
          {otherProjects.map((project, index) => (
            <ProjectCard project={project} index={index + featuredProjects.length} />
          ))}
        </div>
      </div>
    </section>

    <section class="evidence-section page-shell section-space" aria-labelledby="evidence-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Engineering practice <span>02 / 04</span></p>
          <h2 id="evidence-title">Build with care.<br /><em>Ship with evidence.</em></h2>
        </div>
        <p class="section-note">
          The systems behind the products: reliable releases, secure data, and tools people can use with confidence.
        </p>
      </div>
      <div class="evidence-grid">
        {engineeringEvidence.map((item, index) => (
          <article class="evidence-card">
            <span class="evidence-index">{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <a href={item.href} target="_blank" rel="noreferrer">
              {item.source}<span aria-hidden="true"> ↗</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="about-section section-space" id="about" aria-labelledby="about-title">
      <div class="page-shell about-grid">
        <div class="about-title">
          <p class="eyebrow">Engineering approach <span>03 / 04</span></p>
          <h2 id="about-title">Build with care.<br /><em>Ship with purpose.</em></h2>
        </div>
        <div class="about-copy">
          <p class="about-lead">
            I build web and mobile applications, SaaS products and developer tools. My work spans
            frontend development, backend integration, relational databases, authentication,
            automated testing and deployment.
          </p>
          <p>
            At GAB Software Company Limited, I work on software that addresses real business and
            operational needs. I’m particularly interested in reliable product engineering, secure
            data access, local-first developer tooling and software that is practical to use in the
            real world.
          </p>
          <div class="principles">
            <div><span>01</span><p>Useful software, clear architecture, and maintainable documentation.</p></div>
            <div><span>02</span><p>Authentication and data security are core engineering concerns.</p></div>
            <div><span>03</span><p>Changes should be validated through reproducible checks.</p></div>
          </div>
          <figure class="approach-visual">
            <div class="visual-caption"><span>ENGINEERING APPROACH</span><span>CONCEPTUAL MODEL</span></div>
            <svg class="system-visual" viewBox="0 0 560 460" fill="none" aria-hidden="true">
              <path class="visual-path" d="M95 121 254 205M254 205 444 116M254 205 148 350M254 205l203 147" />
              <path class="visual-path visual-path-secondary" d="M95 121h345M148 350h309M95 121 148 350M444 116l13 236" />
              <circle class="visual-orbit" cx="280" cy="229" r="179" />
              <circle class="visual-orbit visual-orbit-secondary" cx="280" cy="229" r="125" />
              <g class="visual-node visual-node-main">
                <circle cx="254" cy="205" r="39" />
                <text x="254" y="210" text-anchor="middle">CORE</text>
              </g>
              <g class="visual-node">
                <circle cx="95" cy="121" r="31" />
                <text x="95" y="125" text-anchor="middle">UI</text>
              </g>
              <g class="visual-node">
                <circle cx="444" cy="116" r="31" />
                <text x="444" y="120" text-anchor="middle">API</text>
              </g>
              <g class="visual-node">
                <circle cx="148" cy="350" r="31" />
                <text x="148" y="354" text-anchor="middle">DATA</text>
              </g>
              <g class="visual-node">
                <circle cx="457" cy="352" r="31" />
                <text x="457" y="356" text-anchor="middle">TOOLS</text>
              </g>
              <circle class="visual-point" cx="353" cy="275" r="4" />
              <circle class="visual-point visual-point-small" cx="204" cy="95" r="3" />
              <circle class="visual-point visual-point-small" cx="379" cy="382" r="3" />
            </svg>
            <figcaption class="visual-foot">
              <span>PRODUCT THINKING</span><span>ENGINEERING DISCIPLINE</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="toolkit-section page-shell section-space" aria-labelledby="toolkit-title">
      <div class="section-heading toolkit-heading">
        <div>
          <p class="eyebrow">Technical toolkit <span>04 / 04</span></p>
          <h2 id="toolkit-title">Tools for the <em>whole stack.</em></h2>
        </div>
        <p class="section-note">Tools I use to build from the interface through to data and delivery.</p>
      </div>
      <div class="toolkit-grid">
        <div><span class="toolkit-index">01</span><h3>Languages</h3><p>Rust · Dart · TypeScript · JavaScript · SQL</p></div>
        <div><span class="toolkit-index">02</span><h3>Web & mobile</h3><p>React · Flutter · Vite</p></div>
        <div><span class="toolkit-index">03</span><h3>Backend & data</h3><p>Supabase · PostgreSQL · Neon · REST APIs · Row-level security</p></div>
        <div><span class="toolkit-index">04</span><h3>Engineering workflow</h3><p>Git · GitHub · CI/CD · Automated testing · Debugging · MCP</p></div>
        <div><span class="toolkit-index">05</span><h3>Deployment</h3><p>Vercel · Cloudflare</p></div>
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="page-shell contact-inner">
        <p class="eyebrow">Recruiter and project enquiries</p>
        <h2 id="contact-title">Let’s talk about<br /><em>thoughtful software.</em></h2>
        <p>
          Software Engineer based in Kampala, Uganda. Open to international and remote opportunities
          across full-stack, mobile, and developer-tool engineering.
        </p>
        <div class="contact-actions">
          <a class="button button-primary" href="mailto:oulachris28@gmail.com">
            Email me <span aria-hidden="true">↗</span>
          </a>
          <a class="button button-primary" href="https://www.linkedin.com/in/oula-chrish-6a538323b" target="_blank" rel="noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="https://github.com/Gabions256" target="_blank" rel="noreferrer">View GitHub <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="/Oula-Chrish-CV.pdf" download>
            Download CV <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
