---
import ProjectVisual from '../../components/ProjectVisual.astro';
import SiteLayout from '../../components/SiteLayout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const title = `${project.name} — Chrish Oula`;
const description = `${project.summary} ${project.status}.`;
const projectIndex = projects.findIndex((item) => item.slug === project.slug);
const previousProject = projects[(projectIndex - 1 + projects.length) % projects.length];
const nextProject = projects[(projectIndex + 1) % projects.length];
const contributionRows: [string, string][] = project.contribution
  ? [['My contribution', project.contribution]]
  : [];
const detailRows: [string, string][] = [
  ['Problem', project.problem],
  ...contributionRows,
  ['Architecture', project.architecture ?? ''],
  ['Key decisions', project.decisions ?? ''],
  ['Privacy and security', project.security ?? ''],
  ['Testing and quality', project.quality ?? ''],
  ['Challenges and lessons', project.challenges ?? ''],
  ['Outcome', project.outcomes],
];
const visibleDetailRows = detailRows.filter(([, content]) => content.length > 0);
---

<SiteLayout title={title} description={description}>
  <main id="main" class="case-study page-shell">
    <div class="reading-progress" aria-hidden="true" data-reading-progress></div>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/#work">Selected work</a><span aria-hidden="true">/</span><span aria-current="page">{project.name}</span>
    </nav>
    <header class="case-hero">
      <div>
        <p class="eyebrow">{project.category}</p>
        <h1>{project.name}<span class="wordmark-period">.</span></h1>
        <p class="case-summary">{project.summary}</p>
        <span class="case-status">{project.status}</span>
      </div>
      <div class="case-index" aria-hidden="true">
        <span>PROJECT STORY</span>
        <strong>{String(projects.findIndex((item) => item.slug === project.slug) + 1).padStart(2, '0')}</strong>
        <span>SELECTED WORK</span>
      </div>
    </header>

    <nav class="case-toc" aria-label="On this page">
      <a href="#overview">Overview</a>
      <a href="#details">The work</a>
      {project.links.length > 0 && <a href="#links">Project links</a>}
    </nav>

    <ProjectVisual project={project} mode="case" />

    <section class="case-overview" id="overview" aria-labelledby="overview-title">
      <p class="eyebrow">Overview</p>
      <h2 id="overview-title">{project.overview}</h2>
      <div class="case-meta-row">
        <div><span>Project stage</span><strong>{project.statusDetail}</strong></div>
        <div><span>Platforms</span><strong>{project.platforms.join(' · ')}</strong></div>
        {project.stack.length > 0 && (
          <div>
            <span>Technology</span>
            <strong>{project.stack.join(' · ')}</strong>
          </div>
        )}
      </div>
    </section>

    <section class="case-details" id="details" aria-labelledby="details-title">
      <div class="case-details-heading">
      <p class="eyebrow">The work</p>
      <h2 id="details-title">Thoughtful decisions.<br /><em>Useful outcomes.</em></h2>
      </div>
      <div class="case-detail-list">
      {visibleDetailRows.map(([label, content], index) => (
          <article class="case-detail">
            <span class="case-detail-number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{label}</h3>
            <p>{content}</p>
          </article>
        ))}
      </div>
    </section>

    {project.links.length > 0 && (
      <section class="case-links" id="links" aria-labelledby="links-title">
        <div>
          <p class="eyebrow">Explore further</p>
          <h2 id="links-title">Project links</h2>
        </div>
        <ul>
          {project.links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noreferrer">
                {link.label}<span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <nav class="case-project-nav" aria-label="Previous and next projects">
      <a href={`/work/${previousProject.slug}`}>
        <span><span aria-hidden="true">←</span> Previous project</span>
        <strong>{previousProject.name}</strong>
      </a>
      <a href={`/work/${nextProject.slug}`}>
        <span>Next project <span aria-hidden="true">→</span></span>
        <strong>{nextProject.name}</strong>
      </a>
    </nav>

    <div class="case-next">
      <a class="text-link" href="/#work"><span aria-hidden="true">←</span> Back to selected work</a>
      <a class="text-link" href="/#contact">Get in touch <span aria-hidden="true">↗</span></a>
    </div>
  </main>
</SiteLayout>
