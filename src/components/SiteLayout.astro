---
import '../styles/global.css';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/og-image.png' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const socialImage = Astro.site ? new URL(image, Astro.site).toString() : undefined;
const sameAs = [
  'https://github.com/Gabions256',
  'https://www.linkedin.com/in/oula-chrish-6a538323b',
];
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Chrish Oula',
  jobTitle: 'Software Engineer',
  email: 'oulachris28@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kampala',
    addressCountry: 'UG',
  },
  sameAs,
  ...(Astro.site ? { url: Astro.site.toString() } : {}),
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111311" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(personSchema).replace(/</g, '\\u003c')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/">
        <span class="wordmark-mark" aria-hidden="true">CO</span>
        <span>Chrish Oula<span class="wordmark-period">.</span></span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="/#contact">Contact</a>
      </nav>
      <div class="header-actions">
        <a
          class="availability"
          href="https://www.linkedin.com/in/oula-chrish-6a538323b"
          target="_blank"
          rel="noreferrer"
        >
          <span class="availability-dot" aria-hidden="true"></span>
          <span>Open to opportunities</span>
        </a>
        <ThemeToggle />
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <a class="wordmark footer-wordmark" href="/">
        <span class="wordmark-mark" aria-hidden="true">CO</span>
        <span>Chrish Oula<span class="wordmark-period">.</span></span>
      </a>
      <p>Software Engineer · Kampala, Uganda</p>
      <div class="footer-links">
        <a href="https://github.com/Gabions256" target="_blank" rel="noreferrer">GitHub</a>
        <a
          href="https://www.linkedin.com/in/oula-chrish-6a538323b"
          target="_blank"
          rel="noreferrer"
        >LinkedIn</a>
        <a href="mailto:oulachris28@gmail.com">Email</a>
        <a href="https://gabdigitalsystem.com" target="_blank" rel="noreferrer">GAB Software</a>
      </div>
      <span class="footer-year">© {new Date().getFullYear()} Chrish Oula</span>
    </footer>
  </body>
</html>
