---
import '../styles/global.css';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/og-image.png' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const socialImage = Astro.site ? new URL(image, Astro.site).toString() : undefined;
const isCaseStudy = Astro.url.pathname.startsWith('/work/');
const sameAs = [
  'https://github.com/Gabions256',
  'https://www.linkedin.com/in/oula-chrish-6a538323b',
];
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Chrish Oula',
  jobTitle: 'Software Engineer',
  email: 'oulachris28@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kampala',
    addressCountry: 'UG',
  },
  sameAs,
  ...(Astro.site ? { url: Astro.site.toString() } : {}),
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('portfolio-theme');
        const systemTheme = window.matchMedia('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark';
        document.documentElement.dataset.theme =
          savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : systemTheme;
      } catch {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111311" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(personSchema).replace(/</g, '\\u003c')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-site-header>
      <a class="wordmark" href={isCaseStudy ? '/' : '#top'}>
        <span class="wordmark-mark" aria-hidden="true">CO</span>
        <span>Chrish Oula<span class="wordmark-period">.</span></span>
      </a>
      <nav class="site-nav" id="site-navigation" aria-label="Main navigation" data-site-nav>
        <a href={isCaseStudy ? '/' : '#top'} data-nav-section="top">Home</a>
        <a
          href={isCaseStudy ? '/#work' : '#work'}
          data-nav-section="work"
          aria-current={isCaseStudy ? 'page' : undefined}
        >Work</a>
        <a href={isCaseStudy ? '/#about' : '#about'} data-nav-section="about">About</a>
        <a href={isCaseStudy ? '/#contact' : '#contact'} data-nav-section="contact">Contact</a>
      </nav>
      <div class="header-actions">
        <a
          class="availability"
          href="https://www.linkedin.com/in/oula-chrish-6a538323b"
          target="_blank"
          rel="noreferrer"
        >
          <span class="availability-dot" aria-hidden="true"></span>
          <span>Open to opportunities</span>
        </a>
        <a class="header-cv" href="/Oula-Chrish-CV.pdf" download aria-label="Download CV as PDF">
          <span class="header-cv-full">Download CV</span>
          <span class="header-cv-short" aria-hidden="true">CV</span>
          <span aria-hidden="true">↓</span>
        </a>
        <ThemeToggle />
        <button
          class="menu-toggle"
          type="button"
          aria-controls="site-navigation"
          aria-expanded="false"
          aria-label="Open navigation"
          data-menu-toggle
          hidden
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <a class="wordmark footer-wordmark" href={isCaseStudy ? '/' : '#top'}>
        <span class="wordmark-mark" aria-hidden="true">CO</span>
        <span>Chrish Oula<span class="wordmark-period">.</span></span>
      </a>
      <p>Software Engineer · Kampala, Uganda</p>
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href={isCaseStudy ? '/#work' : '#work'}>Work</a>
        <a href={isCaseStudy ? '/#about' : '#about'}>About</a>
        <a href={isCaseStudy ? '/#contact' : '#contact'}>Contact</a>
      </nav>
      <div class="footer-links">
        <a href="https://github.com/Gabions256" target="_blank" rel="noreferrer">GitHub</a>
        <a
          href="https://www.linkedin.com/in/oula-chrish-6a538323b"
          target="_blank"
          rel="noreferrer"
        >LinkedIn</a>
        <a href="mailto:oulachris28@gmail.com">Email</a>
        <a href="/Oula-Chrish-CV.pdf" download>Download CV</a>
        <a href="https://gabdigitalsystem.com" target="_blank" rel="noreferrer">GAB Software</a>
      </div>
      <span class="footer-year">© {new Date().getFullYear()} Chrish Oula</span>
    </footer>
    <script is:inline>
      const header = document.querySelector('[data-site-header]');
      const navigation = document.querySelector('[data-site-nav]');
      const menuToggle = document.querySelector('[data-menu-toggle]');

      if (header && navigation && menuToggle) {
        header.dataset.navEnhanced = 'true';
        menuToggle.hidden = false;

        const closeMenu = (restoreFocus = false) => {
          header.dataset.menuOpen = 'false';
          menuToggle.setAttribute('aria-expanded', 'false');
          menuToggle.setAttribute('aria-label', 'Open navigation');
          if (restoreFocus) menuToggle.focus();
        };

        menuToggle.addEventListener('click', () => {
          const isOpen = header.dataset.menuOpen === 'true';
          header.dataset.menuOpen = String(!isOpen);
          menuToggle.setAttribute('aria-expanded', String(!isOpen));
          menuToggle.setAttribute('aria-label', isOpen ? 'Open navigation' : 'Close navigation');
          if (!isOpen) {
            window.requestAnimationFrame(() =>
              window.requestAnimationFrame(() => navigation.querySelector('a')?.focus()),
            );
          }
        });

        navigation.addEventListener('click', (event) => {
          const link = event.target.closest('a');
          if (!link) return;
          closeMenu();
          const url = new URL(link.href, window.location.href);
          if (url.pathname === window.location.pathname && url.hash) {
            const target = document.querySelector(url.hash);
            if (target) {
              target.setAttribute('tabindex', '-1');
              window.setTimeout(() => target.focus({ preventScroll: true }), 0);
            }
          }
        });

        header.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && header.dataset.menuOpen === 'true') {
            event.preventDefault();
            closeMenu(true);
          }
        });

        document.addEventListener('click', (event) => {
          if (header.dataset.menuOpen === 'true' && !header.contains(event.target)) closeMenu();
        });
      }

      const updateHeader = () => {
        if (header) header.dataset.scrolled = String(window.scrollY > 8);
      };
      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });

      const sectionLinks = [...document.querySelectorAll('[data-nav-section]')];
      const homeSections = ['work', 'about', 'contact']
        .map((id) => document.getElementById(id))
        .filter(Boolean);
      const updateActiveSection = () => {
        if (!homeSections.length || window.location.pathname.startsWith('/work/')) return;
        const marker = window.scrollY + (header?.offsetHeight ?? 0) + window.innerHeight * 0.3;
        let current = marker < (homeSections[0]?.offsetTop ?? 0) ? 'top' : 'work';
        for (const section of homeSections) {
          if (section.offsetTop <= marker) current = section.id;
        }
        for (const link of sectionLinks) {
          if (link.dataset.navSection === current) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
        }
      };
      updateActiveSection();
      window.addEventListener('scroll', updateActiveSection, { passive: true });
      window.addEventListener('resize', updateActiveSection, { passive: true });

      if ('IntersectionObserver' in window) {
        const motionTargets = document.querySelectorAll('[data-motion]');
        if (motionTargets.length) {
          document.documentElement.dataset.motionReady = 'true';
          const motionObserver = new IntersectionObserver(
            (entries, observer) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.dataset.motionVisible = 'true';
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.12 },
          );
          motionTargets.forEach((target) => motionObserver.observe(target));
        }
      }

      const progress = document.querySelector('[data-reading-progress]');
      if (progress) {
        let scheduled = false;
        const updateProgress = () => {
          const maximum = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = maximum > 0 ? Math.min(1, Math.max(0, window.scrollY / maximum)) : 0;
          progress.style.transform = `scaleX(${ratio})`;
          scheduled = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!scheduled) {
              scheduled = true;
              window.requestAnimationFrame(updateProgress);
            }
          },
          { passive: true },
        );
        updateProgress();
      }
    </script>
  </body>
</html>
