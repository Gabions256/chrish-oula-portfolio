---
import type { Project } from '../data/projects';
import ProjectVisual from './ProjectVisual.astro';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<article class:list={['project-card', project.featured && 'project-card-featured']}>
  {project.featured && <ProjectVisual project={project} mode="card" />}
  <div class="project-card-content">
    <div class="project-card-top">
      <span class="project-number">{number}</span>
      <span class="project-status">{project.status}</span>
    </div>
    <div class="project-card-body">
      <p class="eyebrow">{project.category}</p>
      <h3><a href={`/work/${project.slug}`}>{project.name}<span aria-hidden="true"> ↗</span></a></h3>
      <p class="project-summary">{project.summary}</p>
      {project.featured && (
        <dl class="project-facts">
          <div><dt>Challenge</dt><dd>{project.problemSummary}</dd></div>
          <div><dt>My focus</dt><dd>{project.contributionSummary}</dd></div>
          <div><dt>Status</dt><dd>{project.outcomeSummary}</dd></div>
        </dl>
      )}
      {project.stack.length > 0 && (
        <ul class="project-stack" aria-label={`${project.name} documented technology`}>
          {project.stack.map((technology) => <li>{technology}</li>)}
        </ul>
      )}
    </div>
    <div class="project-card-bottom">
      <a class="text-link" href={`/work/${project.slug}`}>Read case study <span aria-hidden="true">↗</span></a>
      {project.links[0] && (
        <a
          class="external-link"
          href={project.links[0].href}
          target="_blank"
          rel="noreferrer"
          aria-label={`${project.links[0].label} for ${project.name} (opens in a new tab)`}
        >↗</a>
      )}
    </div>
  </div>
</article>
